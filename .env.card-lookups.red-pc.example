# CollectFolio connection (required). Use the exact browser origin, Supabase
# project URL, and authenticated catalog service URL used by CollectFolio.
# For host-side local services, use host.docker.internal for the JWKS/catalog
# connection; keep COLLECTFOLIO_SUPABASE_URL equal to the JWT's issuer base.
# Example local JWKS: http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
# Example local catalog: http://host.docker.internal:8787
COLLECTFOLIO_APP_URL=
COLLECTFOLIO_SUPABASE_URL=
COLLECTFOLIO_SUPABASE_JWKS_URL=
COLLECTFOLIO_CATALOG_URL=

# Groq (used by: -Provider Groq)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_TIMEOUT_MS=60000

# Direct Ollama Cloud (used by: -Provider OllamaCloud)
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=qwen3.5:397b

# Local Ollama (used by: -Provider OllamaLocal)
OLLAMA_LOCAL_MODEL=qwen3.5:4b
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_TIMEOUT_MS=120000
OLLAMA_PORT=11434

# Stable public HTTPS endpoint (used by: -Tunnel). The one-command bootstrap
# creates a locally managed tunnel under the ignored .cloudflared directory, so
# it needs only the hostname here. For the manual remotely managed alternative,
# paste the connector token below and route the hostname to
# http://card-lookups:4100 as a published application. Enter only the hostname,
# without an https:// prefix or path.
CLOUDFLARE_TUNNEL_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.2

# Host exposure. Keep the default loopback bind unless another device must
# call RED PC directly. Cloudflare Tunnel does not require changing this bind.
COLLECTCAPTURE_BIND_ADDRESS=127.0.0.1
COLLECTCAPTURE_PORT=4100
LOG_LEVEL=info
