NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=localclear-api
OTEL_EXPORT_INTERVAL_MS=60000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_JWT_VERIFICATION_MODE=legacy
# Production defaults to JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
# Set SUPABASE_JWKS_URL only when using a custom discovery endpoint.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=replace-with-at-least-32-random-characters
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key-at-least-32-characters
OPENAI_API_KEY=server-only-openai-api-key
OPENAI_MODEL=gpt-5.6
AI_MEDIA_BUCKET=item-media
DEVICE_COMMAND_SIGNING_PRIVATE_KEY=
DEVICE_COMMAND_SIGNING_KEY_ID=local-development
ACCOUNT_DELETION_HASH_KEY=replace-with-at-least-32-random-characters
PUBLIC_APP_URL=http://localhost:8081
PUBLIC_ADMIN_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4100
# Optional CollectFolio card lookup: set origin, issuer, and catalog together.
# The JWKS override is normally blank; OPENAI_API_KEY must also be configured.
COLLECTFOLIO_APP_URL=
COLLECTFOLIO_SUPABASE_URL=
COLLECTFOLIO_SUPABASE_JWKS_URL=
COLLECTFOLIO_CATALOG_URL=
EXPO_PUBLIC_API_URL=http://localhost:4100
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-id
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
